---
export const prerender = true;

import { contributors, contributorShortName } from "@constants/contributors";
import { partners } from "@constants/partners";
import { url } from "@utils/url";
import GridLayout from "@layouts/grid.astro";
import BackwardButton from "@components/backwardButton.astro";
import ImageWrapper from "@components/common/imageWrapper.astro";
import AuthorCard from "@components/authorCard.astro";

const pageTitle = "Contributors";
const pageDescription = "Who writes for Now or Never, and why we asked them.";

const permanentAuthors = contributors.filter((c) => c.tier === "permanent");
const guestContributors = contributors.filter((c) => c.tier === "guest");

const selectionCriteria = [
    {
        title: "They know something specific.",
        blurb: "Not general wellness enthusiasm — an actual domain where they've done the work and can say something a well-read generalist couldn't.",
    },
    {
        title: "They'll say what they don't know.",
        blurb: "The most useful contributors are the ones who mark the edges of the evidence instead of writing past them.",
    },
    {
        title: "They fit how this site thinks.",
        blurb: "Long view, no hype, comfortable saying the boring answer is usually the right one.",
    },
];

function initialsFor(name: string): string {
    return name
        .replace(/[.,[\]]/g, "")
        .split(" ")
        .filter(Boolean)
        .map((n) => n[0])
        .join("")
        .slice(0, 2)
        .toUpperCase();
}
---

<GridLayout title={pageTitle} description={pageDescription}>
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-6 relative w-full ">
            <BackwardButton currentPath={Astro.url.pathname} />

            <h1 class="mt-4 mb-4 text-90 text-4xl md:text-5xl font-bold">Contributors</h1>

            <p class="font-bold text-lg text-90 relative ml-8 mb-6
                before:w-1 before:h-4 before:rounded-md before:bg-[var(--primary)]
                before:absolute before:left-[-16px] before:top-[5.5px]">
                Who writes here, and why we asked them.
            </p>

            <p class="max-w-[var(--measure)] text-90">
                Now or Never is written primarily by its founder. When a subject calls for expertise beyond that, we bring in someone who has it rather than researching our way to a confident-sounding article.
            </p>
            <p class="mt-4 max-w-[var(--measure)] text-90">
                Guest contributors are invited on the strength of what they know. We don't pay for guest articles and nobody pays us to publish one. Where a contributor is connected to a brand featured on this site, we say so on their entry.
            </p>

            <h2 class="mt-6 mb-4 text-90 text-3xl font-bold">Permanent authors</h2>
            <div class="flex flex-col gap-4">
                {permanentAuthors.map((c) => (
                    <AuthorCard contributor={c} showViewPosts={true} />
                ))}
            </div>

            <h2 class="mt-8 mb-1 text-90 text-3xl font-bold">Guest contributors</h2>
            <p class="text-sm text-black/50 dark:text-white/50 mb-4">Invited writers. Not staff, not paid, not paying.</p>
            <div class="flex flex-col gap-3">
                {guestContributors.map((c) => {
                    const affiliatedPartner = c.affiliatedPartnerSlug
                        ? partners.find((p) => p.slug === c.affiliatedPartnerSlug)
                        : undefined;
                    return (
                        <div class="card-base flex flex-col sm:flex-row overflow-hidden">
                            <div class="w-full h-40 sm:h-auto sm:w-1/3 lg:w-1/4 shrink-0">
                                {c.photo ? (
                                    <ImageWrapper src={c.photo} alt={c.name} class="w-full h-full" />
                                ) : (
                                    <div class="w-full h-full flex items-center justify-center bg-[var(--btn-regular-bg)] text-[var(--btn-content)] font-bold text-2xl" aria-hidden="true">
                                        {initialsFor(c.name)}
                                    </div>
                                )}
                            </div>
                            <div class="flex-1 p-4">
                                <a href={url(`/author/${c.slug}/`)} class="inline-block">
                                    <h3 class="text-base font-semibold text-90 transition-colors hover:text-[var(--primary)]">
                                        {c.name}
                                    </h3>
                                </a>
                                <div class="text-xs uppercase tracking-wide text-black/50 dark:text-white/50 mb-1">
                                    {c.role}
                                </div>
                                <p class="text-sm text-black/70 dark:text-white/70">{c.shortBio || c.blurb}</p>
                                {c.specialties && c.specialties.length > 0 && (
                                    <p class="text-xs text-black/60 dark:text-white/60 mt-2">
                                        <strong>Writes about:</strong> {c.specialties.join(", ")}
                                    </p>
                                )}
                                {affiliatedPartner && c.disclosureText && (
                                    <p class="text-xs italic text-black/50 dark:text-white/50 mt-2">{c.disclosureText}</p>
                                )}
                                <a href={url(`/author/${c.slug}/`)} class="inline-block mt-2 text-sm font-medium text-[var(--primary)] hover:underline">
                                    View all posts by {contributorShortName(c.name)} →
                                </a>
                            </div>
                        </div>
                    );
                })}
            </div>

            <h3 class="flex items-center gap-2 mt-8 mb-1">
                <span class="w-1 h-5 rounded-md bg-[var(--primary)] hidden md:block"></span>
                <span class="font-bold text-3xl text-90">How guest contributors are selected</span>
            </h3>
            <p class="text-sm text-black/60 dark:text-white/60 mb-5">Three things.</p>
            <div class="grid sm:grid-cols-3 gap-x-8 gap-y-5">
                {selectionCriteria.map((c, i) => (
                    <div class="flex gap-3">
                        <span class="shrink-0 w-6 h-6 rounded-full bg-[var(--primary)] text-white text-xs font-bold flex items-center justify-center mt-0.5">{i + 1}</span>
                        <div>
                            <p class="font-semibold text-90 mb-1">{c.title}</p>
                            <p class="text-sm text-black/70 dark:text-white/70">{c.blurb}</p>
                        </div>
                    </div>
                ))}
            </div>

            <div class="mt-8 rounded-[var(--radius-large)] border border-black/10 dark:border-white/20 p-6">
                <h2 class="font-bold text-xl text-90 mb-2">Want to write for us?</h2>
                <p class="text-sm text-black/70 dark:text-white/70">
                    Send a note through the <a href={url("/contact/")} class="link text-[var(--primary)]">contact form</a> — who you are, what you'd write, why you're the one to write it.
                </p>
                <p class="text-sm text-black/70 dark:text-white/70 mt-2">
                    We pass on cold drafts, link-hunting, and anything that could have gone to a hundred other sites. Guest articles aren't for sale either way. Looking for paid placement? That's <a href={url("/partners/advertise/")} class="link text-[var(--primary)]">partners</a>.
                </p>
            </div>
        </div>
    </div>
</GridLayout>
