---
export const prerender = true;

import { getCollection } from "astro:content";

import { profileConfig } from "@/config";
import GridLayout from "@layouts/grid.astro";
import BackwardButton from "@components/backwardButton.astro";
import ImageWrapper from "@components/common/imageWrapper.astro";
import PostPage from "@components/postPage.astro";

const pageTitle = "Paul Meisner";
const pageDescription = "German-born, Wisconsin-based. Writes about faith, training, and the long game.";

// Single-author site today — posts default to Paul unless a future guest
// writer's post sets `author` to their own name.
const allPosts = await getCollection(
    "posts",
    ({ data }) => data.draft !== true && (data.author === "" || data.author === "Paul Meisner"),
);
const sortedPosts = allPosts.sort((a, b) => {
    if (a.data.pinned && !b.data.pinned) return -1;
    if (!a.data.pinned && b.data.pinned) return 1;
    return new Date(a.data.published) > new Date(b.data.published) ? -1 : 1;
});

// Same @id declared on /about/ — do not create a second Person entity for Paul.
const personId = new URL("/about/#person-paul-meisner", Astro.site).toString();
const profilePageSchema = {
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    dateCreated: sortedPosts.at(-1)?.data.published,
    dateModified: new Date().toISOString(),
    mainEntity: {
        "@id": personId,
    },
};
---

<GridLayout title={pageTitle} description={pageDescription}>
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-6 relative w-full ">
            <BackwardButton currentPath={Astro.url.pathname} />

            <div class="flex items-center gap-4 mt-4">
                <ImageWrapper
                    src={profileConfig.avatar || ""}
                    alt="Paul Meisner"
                    class="w-16 h-16 md:w-20 md:h-20 rounded-full overflow-hidden shrink-0"
                />
                <div>
                    <h1 class="mb-0 text-90">Paul Meisner</h1>
                    <p class="text-black/50 dark:text-white/50 text-sm mt-1">Founder and Editor, Now or Never</p>
                </div>
            </div>

            <p class="mt-6 max-w-[var(--measure)] text-90">
                Paul Meisner is the founder and editor of Now or Never. He was born and raised in Germany and came to the United States for college, where he studied software engineering and information systems. He works in SEO and operations, keeps a few head of cattle on the side, and gardens badly but persistently. He came to the Catholic faith in 2022 after growing up without one — a decision that shapes how he writes about discipline, stewardship, and the long game. He lives in Freedom, Wisconsin with his wife and children. He is not a physician, and this site does not publish medical advice.
            </p>

            <div class="flex items-center gap-3 mt-4 text-sm text-black/50 dark:text-white/50">
                <em>Links: LinkedIn · X · Instagram — to be added</em>
            </div>

            <h2 class="mt-8 mb-4 text-90">Posts by Paul</h2>
            {sortedPosts.length > 0 ? (
                <PostPage page={{ data: sortedPosts }} />
            ) : (
                <p class="text-black/50 dark:text-white/50">Nothing published yet — check back soon.</p>
            )}
        </div>
    </div>
</GridLayout>

<script type="application/ld+json" is:inline set:html={JSON.stringify(profilePageSchema)} />
