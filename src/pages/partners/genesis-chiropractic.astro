---
export const prerender = true;

import { getEntry, render } from "astro:content";
import { partners } from "@constants/partners";
import { url } from "@utils/url";
import Markdown from "@components/common/markdown.astro";
import GridLayout from "@layouts/grid.astro";
import BackwardButton from "@components/backwardButton.astro";
import PartnerHero from "@components/partnerHero.astro";
import PartnerContactCard from "@components/partnerContactCard.astro";
import PartnerDisclosureBanner from "@components/partnerDisclosureBanner.astro";

const partner = partners.find((p) => p.slug === "genesis-chiropractic")!;
const pageTitle = "Genesis Chiropractic";
const pageDescription = "Partner feature: the Army medic and the collegiate athlete who built Genesis Chiropractic on the Gonstead method — precision over volume.";

const genesisPost = await getEntry("spec", "genesis-chiropractic");

if (!genesisPost) {
    throw new Error("Genesis Chiropractic page content not found");
}

const { Content } = await render(genesisPost);

const articleSchema = {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: "The Army Medic and the Collegiate Athlete Who Built a Practice on Precision",
    description: pageDescription,
    url: Astro.url.toString(),
    datePublished: "2026-09-05",
    dateModified: "2026-09-05",
    author: {
        "@id": new URL("/about/#person-paul-meisner", Astro.site).toString(),
    },
    sponsor: {
        "@type": "Organization",
        name: "Genesis Chiropractic",
        url: "https://genesischirowi.com/",
        sameAs: [],
    },
};
---

<GridLayout title={pageTitle} description={pageDescription}>
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-6 relative w-full ">
            <BackwardButton currentPath={Astro.url.pathname} />
            <span class="inline-block mt-2 px-2.5 py-1 rounded-md text-xs font-medium tracking-wide uppercase bg-[var(--btn-regular-bg)] text-[var(--btn-content)]">
                Partner feature
            </span>
            <div class="mt-2 text-sm text-black/50 dark:text-white/50">
                By <a href={url("/author/paul-meisner/")} class="link hover:text-[var(--primary)]">Paul Meisner</a>
            </div>
            <PartnerDisclosureBanner partnerName={partner.name} class="mt-2" />
            <PartnerHero partner={partner} />
            <PartnerContactCard partner={partner} class="mt-4" />
            <Markdown class="mt-6">
                <Content />
            </Markdown>
        </div>
    </div>
</GridLayout>

<script type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)} />
