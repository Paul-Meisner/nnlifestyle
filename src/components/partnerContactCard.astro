---
import { Icon } from "astro-icon/components";

import type { PartnerBrand } from "@constants/partners";
import { url } from "@utils/url";

interface Props {
    partner: PartnerBrand;
    class?: string;
    // Adds a "read the full feature" link — used on the /partners/ index; the
    // feature page itself doesn't need it since the article underneath IS the feature.
    showReadMore?: boolean;
}

const { partner, class: className, showReadMore = false } = Astro.props;

// No API key needed for this embed form — it just needs a query, not a place ID.
const mapEmbedSrc = partner.address
    ? `https://www.google.com/maps?q=${encodeURIComponent(partner.address)}&output=embed`
    : null;
---

<div class:list={[className, "card-base flex flex-col gap-5 p-5"]}>
    <!-- Row 1: logo + name -->
    <div class="flex items-center gap-4">
        <div class="flex items-center justify-center h-16 w-28 shrink-0 rounded-lg overflow-hidden">
            <img src={url(partner.logo)} alt={`${partner.name} logo`} class="max-h-14 max-w-full object-contain" loading="lazy" />
        </div>
        <div>
            <h3 class="font-bold text-lg text-90">{partner.name}</h3>
            <div class="text-xs uppercase tracking-wide text-black/50 dark:text-white/50 mt-0.5">
                {partner.categories.join(" · ")}
            </div>
        </div>
    </div>

    <!-- Row 2: bio -->
    <p class="text-sm text-black/70 dark:text-white/70">{partner.summary}</p>

    <!-- Row 3: embedded map + business information -->
    <div class="flex flex-col sm:flex-row gap-4">
        <div class="sm:w-1/2 shrink-0 rounded-lg overflow-hidden h-48">
            {mapEmbedSrc ? (
                <iframe
                    src={mapEmbedSrc}
                    class="w-full h-full border-0"
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    title={`Map to ${partner.name}`}
                ></iframe>
            ) : (
                <div class="w-full h-full flex flex-col items-center justify-center gap-1 bg-[var(--btn-regular-bg)] text-black/40 dark:text-white/40">
                    <Icon name="material-symbols:map-outline-rounded" class="text-3xl" />
                    <span class="text-xs italic">Map — pending address confirmation</span>
                </div>
            )}
        </div>

        <div class="flex-1 flex flex-col gap-2 justify-center">
            <div class:list={["flex items-start gap-2 text-sm", partner.address ? "text-black/70 dark:text-white/70" : "text-black/40 dark:text-white/40 italic text-xs"]}>
                <Icon name="material-symbols:location-on-outline-rounded" class="text-[1.1rem] mt-0.5 shrink-0 text-black/40 dark:text-white/40" />
                <span>{partner.address || "Address — to be added"}</span>
            </div>

            <div class:list={["flex items-center gap-2 text-sm", !partner.phone && "text-black/40 dark:text-white/40 italic text-xs"]}>
                <Icon name="material-symbols:call-outline-rounded" class="text-[1.1rem] shrink-0 text-black/40 dark:text-white/40" />
                {partner.phone ? (
                    <a href={`tel:${partner.phone.replace(/[^\d+]/g, "")}`} class="link text-black/70 dark:text-white/70 hover:text-[var(--primary)]">
                        {partner.phone}
                    </a>
                ) : (
                    <span>Phone — to be added</span>
                )}
            </div>

            <div class:list={["flex items-start gap-2 text-sm", partner.hours ? "text-black/70 dark:text-white/70" : "text-black/40 dark:text-white/40 italic text-xs"]}>
                <Icon name="material-symbols:schedule-outline-rounded" class="text-[1.1rem] mt-0.5 shrink-0 text-black/40 dark:text-white/40" />
                <span>{partner.hours || "Hours — to be added"}</span>
            </div>

            <div class="flex items-center gap-2 text-sm">
                <Icon name="material-symbols:language" class="text-[1.1rem] shrink-0 text-black/40 dark:text-white/40" />
                <a href={partner.website} target="_blank" rel="sponsored noopener" class="link text-[var(--primary)] font-medium">
                    {partner.website.replace(/^https?:\/\//, "").replace(/\/$/, "")}
                </a>
            </div>

            <div class:list={["flex items-center gap-2 text-sm", !partner.gbpUrl && "text-black/40 dark:text-white/40 italic text-xs"]}>
                <Icon name="fa6-brands:google" class="text-[1rem] shrink-0 text-black/40 dark:text-white/40" />
                {partner.gbpUrl ? (
                    <a href={partner.gbpUrl} target="_blank" rel="noopener" class="link text-black/70 dark:text-white/70 hover:text-[var(--primary)]">
                        View on Google
                    </a>
                ) : (
                    <span>Google Business Profile — link pending</span>
                )}
            </div>
        </div>
    </div>

    {showReadMore && (
        <a href={url(`/partners/${partner.slug}/`)} class="link text-sm font-medium text-[var(--primary)]">
            Read the full feature →
        </a>
    )}
</div>
