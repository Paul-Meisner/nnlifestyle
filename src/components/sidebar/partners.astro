---
import { partners } from "@constants/partners";
import { url } from "@utils/url";
import WidgetLayout from "./widgetLayout.astro";


interface Props {
    class?: string;
    style?: string;
    side?: string;
}
const { class: className, style, side = "default" } = Astro.props;
---

<WidgetLayout name="Partners" id={`partners-${side}`} class={className} style={style}>
    <div class="flex flex-col gap-2">
        {partners.map((p) => (
            <a
                href={url(`/partners/${p.slug}/`)}
                class="link flex items-center gap-2 rounded-lg p-1.5 -m-1.5 hover:bg-[var(--btn-plain-bg-hover)] transition-colors duration-150"
            >
                <img src={url(p.logo)} alt={`${p.name} logo`} class="w-8 h-8 rounded-md object-contain shrink-0" loading="lazy" />
                <span class="text-sm text-75 truncate">{p.name}</span>
            </a>
        ))}
        <a href={url('/partners/')} class="link text-sm text-[var(--primary)] font-medium mt-1">
            View all partners →
        </a>
    </div>
</WidgetLayout>
