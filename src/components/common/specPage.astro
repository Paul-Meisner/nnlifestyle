---
import { getEntry, render } from "astro:content";

import Markdown from "@components/common/markdown.astro";
import GridLayout from "@layouts/grid.astro";
import BackwardButton from "@components/backwardButton.astro";

interface Props {
    specSlug: string;
    title: string;
    description: string;
}

const { specSlug, title, description } = Astro.props;

const post = await getEntry("spec", specSlug);

if (!post) {
    throw new Error(`Spec page content not found: ${specSlug}`);
}

const { Content } = await render(post);
---

<GridLayout title={title} description={description}>
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-6 relative w-full ">
            <BackwardButton currentPath={Astro.url.pathname} />
            <Markdown class="mt-2">
                <Content />
            </Markdown>
        </div>
    </div>
</GridLayout>
