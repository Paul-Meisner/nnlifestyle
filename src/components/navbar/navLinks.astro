---
import { Icon } from "astro-icon/components";

import { LinkPresets } from "@constants/link-presets";
import { LinkPreset, type NavbarLink } from "@/types/config";
import { url } from "@utils/url";


interface Props {
    link: NavbarLink;
    class?: string;
}

const { link, class: className } = Astro.props;

const children: NavbarLink[] = (link.children || []).map(
    (item: NavbarLink | LinkPreset): NavbarLink => {
        if (typeof item === "number") {
            return LinkPresets[item];
        }
        return item;
    },
);
const hasChildren = children.length > 0;
---

<div class:list={["nav-link-container", { "dropdown-container": hasChildren }, className]}>
    <a
        aria-label={link.name}
        href={link.external ? link.url : url(link.url)}
        target={link.external ? "_blank" : null}
        class="btn-plain scale-animation rounded-lg h-11 font-bold px-3 active:scale-95 nav-link-item"
        data-link-name={link.name}
    >
        <div class="flex items-center">
            {link.icon && <Icon name={link.icon} class="text-[1.1rem] nav-link-icon" />}
            <span class="nav-link-text ml-2 hidden lg:inline">{link.name}</span>
            {hasChildren && (
                <Icon
                    name="material-symbols:keyboard-arrow-down-rounded"
                    class="dropdown-arrow transition text-[1.1rem] ml-0.5 hidden lg:inline"
                />
            )}
            {link.external && <Icon name="fa6-solid:arrow-up-right-from-square" class="text-[0.875rem] transition -translate-y-[1px] ml-1 text-black/[0.2] dark:text-white/[0.2]" />}
        </div>
    </a>
    {hasChildren && (
        <div class="dropdown-menu hidden lg:block">
            <div class="dropdown-content">
                {children.map((child) => (
                    <a
                        href={child.external ? child.url : url(child.url)}
                        target={child.external ? "_blank" : null}
                        class="dropdown-item"
                        aria-label={child.description || child.name}
                    >
                        <span class="flex items-center gap-2">
                            {child.icon && <Icon name={child.icon} class="text-[1rem]" />}
                            {child.name}
                        </span>
                        {child.external && <Icon name="fa6-solid:arrow-up-right-from-square" class="text-[0.75rem] text-black/25 dark:text-white/25" />}
                    </a>
                ))}
            </div>
        </div>
    )}
</div>

<style>
    .nav-link-container {
        @apply relative;
    }

    /* 小屏幕时只显示图标 */
    @media (max-width: 1279px) {
        .nav-link-item {
            @apply w-11 px-0 flex items-center justify-center;
        }

        .nav-link-text {
            @apply hidden;
        }

        .nav-link-icon {
            @apply ml-0;
        }

        .dropdown-arrow {
            @apply hidden;
        }
    }

    /* 大屏幕时显示图标+文字 */
    @media (min-width: 1280px) {
        .nav-link-item {
            @apply px-3;
        }

        .nav-link-text {
            @apply inline;
        }
    }
</style>
