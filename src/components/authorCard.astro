---
import type { Contributor } from "@constants/contributors";
import { url } from "@utils/url";
import ImageWrapper from "@components/common/imageWrapper.astro";

interface Props {
    contributor: Contributor;
    class?: string;
    // Whether to show the "View all posts by X" link — off by default since some
    // callers (like /about/) may want to link elsewhere or not at all.
    showViewPosts?: boolean;
}

const { contributor, class: className, showViewPosts = false } = Astro.props;

function initialsFor(name: string): string {
    return name
        .replace(/[.,[\]]/g, "")
        .split(" ")
        .filter(Boolean)
        .map((n) => n[0])
        .join("")
        .slice(0, 2)
        .toUpperCase();
}
---

<div class:list={[className, "card-base flex flex-col md:flex-row overflow-hidden"]}>
    <div class="w-full h-48 md:h-auto md:w-1/3 lg:w-1/4 shrink-0">
        {contributor.photo ? (
            <ImageWrapper
                src={contributor.photo}
                alt={contributor.name}
                class="w-full h-full"
            />
        ) : (
            <div class="w-full h-full flex items-center justify-center bg-[var(--btn-regular-bg)] text-[var(--btn-content)] font-bold text-3xl" aria-hidden="true">
                {initialsFor(contributor.name)}
            </div>
        )}
    </div>
    <div class="flex-1 p-6">
        <h3 class="text-xl font-semibold mb-1 text-90">{contributor.name}</h3>
        <div class="text-xs uppercase tracking-wide text-black/50 dark:text-white/50 mb-2">
            {contributor.role}
        </div>
        <p class="text-sm text-black/70 dark:text-white/70">{contributor.blurb}</p>
        {contributor.professionalLinksNote && (
            <p class="text-sm italic text-black/50 dark:text-white/50 mt-2">{contributor.professionalLinksNote}</p>
        )}
        {showViewPosts && (
            <a href={url(`/author/${contributor.slug}/`)} class="inline-block mt-2 text-sm font-medium text-[var(--primary)]">
                View all posts by {contributor.name.split(" ")[0]} →
            </a>
        )}
    </div>
</div>
